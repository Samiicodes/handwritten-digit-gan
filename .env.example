# Copy to .env to override settings locally. Every entry is optional.
# Values set in the shell take precedence over this file.

# Alternative configuration file
# DIGITGAN_CONFIG_PATH=config/config.yaml

# Log level for the scripts and the API
# DIGITGAN_LOG_LEVEL=INFO

# Interface and port for the API
# DIGITGAN_API_HOST=127.0.0.1
# DIGITGAN_API_PORT=8000

# Generator served by the API and used by scripts/generate_digits.py
# DIGITGAN_CHECKPOINT_PATH=runs/cgan_seed42/generator.pt
